# LiteLLM proxy for Lift Wing Studio (deployment-charts: helmfile.d/ml-services/liftwing-studio).
#
# NOTE: this is a retag of the upstream image, NOT a rebuild from WMF base images.
# Kubernetes nodes can only pull from docker-registry.wikimedia.org, so the upstream
# image is imported here and republished under the ml/ namespace. Keep the tag pinned
# and bump it (with the changelog) to upgrade. The build host reaches ghcr.io through
# the configured web proxy.
#
# The upstream "non_root" variant already runs as uid 65534 (nobody) with HOME=/app,
# so it satisfies runAsNonRoot as is. Its entrypoint wraps the `litellm` CLI; the chart
# passes "--config /etc/litellm/config.yaml --port 4000".
FROM ghcr.io/berriai/litellm-non_root:v1.99.1
USER 65534
