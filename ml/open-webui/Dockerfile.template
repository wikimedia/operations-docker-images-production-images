# Open WebUI for Lift Wing Studio (deployment-charts: helmfile.d/ml-services/liftwing-studio).
#
# NOTE: this is a retag of the upstream image, NOT a rebuild from WMF base images.
# Kubernetes nodes can only pull from docker-registry.wikimedia.org, so the upstream
# image is imported here and republished under the ml/ namespace. Keep the tag pinned
# and bump it (with the changelog) to upgrade. The build host reaches ghcr.io through
# the configured web proxy.
#
# The "slim" variant ships without the bundled sentence-transformers embedding model
# and whisper STT model; the deployment sets RAG_EMBEDDING_ENGINE=openai and
# AUDIO_STT_ENGINE=openai so neither is needed.
FROM ghcr.io/open-webui/open-webui:v0.11.3-slim

# Upstream builds with UID=0 and runs as root. Our pods enforce runAsNonRoot, so run
# as "somebody" (uid 65533, the standard WMF unprivileged uid; config-ml.yaml has no
# known_uid_mappings so it is spelled out numerically). Everything Open WebUI writes
# goes to DATA_DIR (/app/backend/data, an emptyDir volume in Kubernetes) or to $HOME
# caches, which we point at /tmp. Side effect: uploading a custom logo/favicon from the
# admin UI (which writes into /app/backend/open_webui/static) is not possible.
USER root
RUN groupadd -o -g 65533 -r somebody \
    && useradd -l -o -r -m -d /var/lib/somebody -g somebody -u 65533 somebody \
    && chown -R 65533:65533 /app/backend/data
ENV HOME=/tmp
USER 65533
